# Optional SMTP configuration for learning analytics report delivery.
# Leave unset to keep the dashboard running without email delivery.
LEARNING_ANALYTICS_SMTP_HOST=smtp.example.com
LEARNING_ANALYTICS_SMTP_PORT=587
LEARNING_ANALYTICS_SMTP_USERNAME=your-smtp-username
LEARNING_ANALYTICS_SMTP_PASSWORD=your-smtp-password
LEARNING_ANALYTICS_REPORT_FROM=reports@example.com
LEARNING_ANALYTICS_SMTP_USE_TLS=true
